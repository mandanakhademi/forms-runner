{
  "name": "GOV.UK Forms Runner Development Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/ruby:2": {
      "version": "3.4.8",
      "versionManager": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22",
      "installYarnUsingApt": false
    },
    "ghcr.io/devcontainers/features/copilot-cli:1": {}
  },
  "updateContentCommand": "sudo apt-get update && sudo apt-get install -y build-essential libpq-dev git postgresql postgresql-contrib redis-server && sudo mkdir -p /usr/local/share/nvim/runtime && sudo git clone --depth 1 --branch v0.12.4 https://github.com/neovim/neovim.git /tmp/neovim-src && sudo cp -r /tmp/neovim-src/runtime/* /usr/local/share/nvim/runtime/ && sudo rm -rf /tmp/neovim-src && echo \"vim.o.background = 'dark'\" >> ~/.config/nvim/init.lua || true",
  "postCreateCommand": "sudo service postgresql start && sudo service redis-server start && sudo -u postgres psql -c \"ALTER USER postgres WITH PASSWORD 'postgres';\" && bundle install && npm install && ./bin/setup",
  "postStartCommand": "sudo service postgresql start || true && sudo service redis-server start || true",
  "containerEnv": {
    "DATABASE_URL": "postgresql://postgres:postgres@localhost:5432/forms_runner_development",
    "REDIS_URL": "redis://localhost:6379/0",
    "RAILS_ENV": "development",
    "PORT": "3001"
  },
  "forwardPorts": [3001, 3038, 3039],
  "portsAttributes": {
    "3001": {
      "label": "GOV.UK Forms Runner Web App",
      "onAutoForward": "openPreview"
    },
    "3038": {
      "label": "Vite Dev Server",
      "onAutoForward": "notify"
    },
    "3039": {
      "label": "Vite HMR",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "files.eol": "\n",
        "files.insertFinalNewline": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        },
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode",
          "editor.tabSize": 2
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[scss]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "ruby.lint.rubocop": true
      },
      "extensions": [
        "kaiwood.endwise",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker",
        "vitest.explorer",
        "banyis.rspec-snippets",
        "test-explorer.vscode-test-explorer",
        "editorconfig.editorconfig",
        "donjayamanne.githistory",
        "yzhang.markdown-all-in-one",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "anthropic.claude-code",
        "rebornix.Ruby",
        "castwide.solargraph",
        "misogi.ruby-rubocop",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "remoteUser": "vscode"
}
